// K-lawus CMS schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScammerStatus {
  PENDING
  SCREENED
  EVIDENCE
}

enum UserRole {
  LAWYER
  MEMBER
}

enum ServiceType {
  CREDIT_CHECK
  BACKGROUND_CHECK
  DEBT_CREDIT_REPORTING
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  WAIVED
  REFUNDED
}

enum BureauReportStatus {
  NONE
  QUEUED
  EXPORTED
  SUBMITTED
  ACKNOWLEDGED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model EmailNotification {
  id         String      @id @default(cuid())
  to         String
  subject    String
  body       String
  kind       String      // welcome_member | welcome_lawyer | service_received | service_status | column_published | report_received | report_status | scammer_transition | admin_notice
  relatedId  String?
  status     EmailStatus @default(QUEUED)
  error      String?
  createdAt  DateTime    @default(now())
  sentAt     DateTime?

  @@index([status, createdAt])
  @@index([kind])
}

model InviteCode {
  id         String    @id @default(cuid())
  code       String    @unique
  note       String?
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
  user       User?
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  phone        String?
  state        String?
  role         UserRole    @default(MEMBER)

  // Lawyer-only fields
  firm         String?
  barNumber    String?
  field        String?
  bio          String?

  inviteCodeId String?     @unique
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id])

  columns         Column[]
  serviceRequests ServiceRequest[]
  uploads         UploadedFile[]
  submittedScammers Scammer[]       @relation("ScammerSubmitter")
  scammerReviews    ScammerReview[]

  createdAt    DateTime    @default(now())
}

model UploadedFile {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  size       Int
  bytes      Bytes
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  columnCovers     Column[]
  scammerPhotos    Scammer[]         @relation("ScammerPhoto")
  scamTypeIcons    ScamType[]        @relation("ScamTypeIcon")
  articleCovers    Article[]         @relation("ArticleCover")
  businessPhotos   HonestBusiness[]  @relation("HonestBusinessPhoto")
}

model Column {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  field       String
  excerpt     String
  body        String
  cat         String    @default("cat-realestate")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  coverImageId String?
  coverImage   UploadedFile? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  sponsorLabel   String?
  sponsorWho     String?
  sponsorContact String?

  @@index([published, publishedAt])
  @@index([authorId])
}

model Scammer {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  type        String
  location    String
  aliases     String?
  cases       Int           @default(1)
  status      ScammerStatus @default(PENDING)
  cat         String        @default("cat-crime")
  brief       String
  overview    String
  patterns    String[]
  progress    String
  damage      String?
  firstReport String?
  lastUpdate  String?
  published   Boolean       @default(true)

  photoFileId    String?
  photo          UploadedFile? @relation("ScammerPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)

  submitterEmail String?
  submittedById  String?
  submittedBy    User?    @relation("ScammerSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  reviews        ScammerReview[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, updatedAt])
  @@index([status])
}

model ScammerReview {
  id         String         @id @default(cuid())
  scammerId  String
  scammer    Scammer        @relation(fields: [scammerId], references: [id], onDelete: Cascade)
  action     String         // "submitted" | "screened" | "evidence" | "rejected" | "edit" | "publish" | "unpublish"
  fromStatus ScammerStatus?
  toStatus   ScammerStatus?
  note       String?
  byAdmin    Boolean        @default(false)
  byUserId   String?
  byUser     User?          @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  byEmail    String?
  createdAt  DateTime       @default(now())

  @@index([scammerId, createdAt])
}

model ScamType {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  title      String
  sign       String
  flag       String
  act        String
  iconFileId String?
  icon       UploadedFile? @relation("ScamTypeIcon", fields: [iconFileId], references: [id], onDelete: SetNull)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}

model ServiceRequest {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ServiceType
  status     ServiceStatus  @default(PENDING)
  payment    PaymentStatus  @default(UNPAID)
  priceCents Int            @default(0)

  // Subject of the check / debt
  subjectName    String
  subjectPhone   String?
  subjectEmail   String?
  subjectAddress String?
  subjectDob     String?
  subjectSsn4    String?

  note      String?

  // Admin handling
  adminNote String?
  resultUrl String?

  // For DEBT_CREDIT_REPORTING
  debtAmountCents  Int?
  debtSince        String?
  creditorName     String?
  reportExperian   Boolean             @default(false)
  reportTransUnion Boolean             @default(false)
  reportEquifax    Boolean             @default(false)
  bureauStatus     BureauReportStatus  @default(NONE)
  metroExportUrl   String?

  requestedAt DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

// ============== Round 9 additions ==============

model SiteLabel {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum ArticleCategory {
  HISTORY        // 미주 한인사회 사기사 (long-form history articles)
  CASE_STUDY     // 사기 사례 (notable case studies, deeper than the warning entries)
  PREVENTION     // 사기 대처방법 (전후 가이드)
  SAFE_TX        // 사기를 피할 수 있는 거래 방법
}

model Article {
  id           String          @id @default(cuid())
  slug         String          @unique
  category     ArticleCategory
  title        String
  excerpt      String
  body         String
  cat          String          @default("cat-crime")
  coverImageId String?
  coverImage   UploadedFile?   @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  order        Int             @default(0)
  published    Boolean         @default(false)
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, published, publishedAt])
}

model HonestBusiness {
  id          String        @id @default(cuid())
  name        String
  category    String        // 식당·마트·세탁·병원 등
  location    String
  phone       String?
  website     String?
  endorsedBy  String?       // 추천한 변호사·매체
  note        String?
  photoFileId String?
  photo       UploadedFile? @relation("HonestBusinessPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  published   Boolean       @default(true)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, updatedAt])
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

model ScamAlert {
  id        String         @id @default(cuid())
  title     String
  body      String
  link      String?
  severity  AlertSeverity  @default(HIGH)
  active    Boolean        @default(true)
  popup     Boolean        @default(false)
  expiresAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([active, createdAt])
}
